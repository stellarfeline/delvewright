# Delvewright delve image (ADR-0010): pinned vanilla server + compiled datapack +
# server config, baked into one runnable OCI image. `docker run <image>` (with the
# operator's EULA acceptance) yields a joinable dungeon.
#
# The build context is a compiler build output tree `<out>/` (produced by
# `delvec build <campaign> -o <out>`). Build with that dir as context:
#
#     delvec build crates/dsl/fixtures/valid/hello-world -o out
#     docker build -f validation/Dockerfile.delve -t delvewright/hello-world out/
#
# ADR-0010 (EULA): the server jar is NEVER baked. The base itzg entrypoint fetches
# the pinned jar (by version + checksum) at first run; only the datapack + config —
# all bytes we authored (ADR-0006) — live in image layers. The operator accepts the
# EULA at run time (EULA=TRUE); this image never sets it.
#
# ADR-0003: NO mods here. PackTest/Fabric live only in the validate-profile tooling
# services, never in the shipped delve image.

# The delve runtime base: our own GHCR mirror of itzg/minecraft-server, pinned by
# immutable digest (spec-0005, ADR-0006/0009 — MC 1.21.11, java21). Mirroring under
# our namespace shields us from Docker Hub anon-pull limits and upstream deletion.
# The digest is the single-source value in versions.toml ([images.base].digest) and
# equals the itzg source index digest (buildx imagetools create copies it verbatim);
# check-versions.sh fails CI if it drifts. Overridable via --build-arg for local
# pre-publish verification against the byte-identical itzg source (same digest).
ARG DELVE_BASE_IMAGE=ghcr.io/stellarfeline/delvewright-base@sha256:3e7db2562b492dbf442568a327d361547628c98c04a7cb68218c8dde6abdd1de
FROM ${DELVE_BASE_IMAGE}

# Bake the compiled datapack outside /data (which is a runtime volume). itzg's
# DATAPACKS env accepts a directory in the container and copies it into the world's
# datapacks folder on first boot.
COPY datapack /delve/datapack
# Provenance: the compiler's server config + manifest travel with the image, even
# though world gen below is driven by the itzg env vars mirrored from it.
COPY server /delve/server
COPY manifest.json /delve/manifest.json
COPY critical-path.json /delve/critical-path.json

ENV TYPE=VANILLA \
    VERSION=1.21.11 \
    DATAPACKS=/delve/datapack \
    # World config mirrored from the compiler's server/server.properties (spec-0002
    # void/superflat + fixed seed). The campaign-varying values (`difficulty`,
    # `level-seed`, and — spec-0013 v0.6 — `level-type` + `generator-settings`) are
    # sourced from that file by the entrypoint wrapper below, so they cannot drift;
    # these ENV values are only the fallback if the file is absent. (v0.3: combat-wave
    # campaigns need `difficulty=easy` — peaceful removes summoned mobs — while
    # wave-free delves stay `peaceful`. v0.6: `horizon:"ocean"` campaigns emit an
    # ocean superflat generator-settings the wrapper picks up here.)
    MODE=adventure \
    DIFFICULTY=peaceful \
    FORCE_GAMEMODE=true \
    LEVEL_TYPE=minecraft:flat \
    # Quotes must be backslash-escaped or Docker ENV strips them, corrupting the
    # JSON (itzg would then write invalid generator-settings and the server dies
    # with a gson syntax error).
    GENERATOR_SETTINGS="{\"biome\":\"minecraft:the_void\",\"layers\":[]}" \
    SEED=20260729 \
    GENERATE_STRUCTURES=false \
    SPAWN_MONSTERS=false \
    SPAWN_PROTECTION=0 \
    ALLOW_NETHER=false \
    PVP=false \
    # Offline by default for local play/validation; the owner sets ONLINE_MODE=TRUE
    # to join with a real account (spec-0003 auth-mode note).
    ONLINE_MODE=FALSE

# Derive the campaign-varying world settings from the compiler's server.properties
# at container start, then hand off to itzg's entrypoint - so the shipped image
# honours the compiler output (no drift) without a per-campaign Dockerfile. itzg
# reads DIFFICULTY/SEED/LEVEL_TYPE/GENERATOR_SETTINGS env when it generates
# server.properties.
#
# The body below is BYTE-IDENTICAL to validation/world-settings-entrypoint.sh, the
# same script the compose `packtest` runner mounts - so the tooling server and the
# shipped delve boot the same world. validation/check-world-settings.sh fails CI if
# the two ever drift. Edit the .sh file and re-sync this block, never one alone.
RUN cat > /delve/entrypoint.sh <<'EOS' && chmod +x /delve/entrypoint.sh
#!/usr/bin/env bash
# Derive the campaign-varying world settings from the compiler's server.properties
# and hand off to the itzg entrypoint. Used by EVERY server that boots a build
# output: the shipped delve image (baked by Dockerfile.delve) and the validation
# PackTest runner (mounted by compose.yaml). One source, so no server can run a
# different world than the compiler declared.
#
# CONTRACT: this file and the heredoc body in validation/Dockerfile.delve are
# byte-identical; validation/check-world-settings.sh fails CI if they drift.
#
# It also owns DELVE_RESET_WHEN_EMPTY (spec-0064): the seconds every reading of
# the online player count must be zero across before this delve is removed and
# built again from the image. Unset, none of it runs.
set -e
props="${DELVE_SERVER_PROPERTIES:-/delve/server/server.properties}"
if [ ! -f "$props" ]; then
  echo "FATAL: $props is missing - cannot derive the world the compiler declared;" >&2
  echo "refusing to boot a world that is not this campaign's." >&2
  exit 1
fi
# spec-0064: the last player leaves, and the delve is built again.
# DELVE_RESET_WHEN_EMPTY is the WINDOW, in seconds, that EVERY reading of the
# online player count must be zero across before this world is thrown away and
# built again from the image. Unset is OFF, and off is this script exactly as it
# was: no daemon, no removal, `exec` at the bottom, mc-server-runner as PID 1.
#
# Validated HERE, before a single setting is derived and long before anything is
# removed. The flag was asked for, so a value that cannot be honoured refuses the
# boot: a server that starts with the flag silently ignored is the silent-default
# defect, and it would be discovered by a host only when a stranger walked into
# the previous stranger's finished delve.
if [ -n "${DELVE_RESET_WHEN_EMPTY:-}" ]; then
  case "$DELVE_RESET_WHEN_EMPTY" in
    *[!0-9]*|'')
      echo "FATAL: DELVE_RESET_WHEN_EMPTY='$DELVE_RESET_WHEN_EMPTY' is not a whole number of seconds." >&2
      echo "It is the window every player-count reading must be zero across, and its floor is 60." >&2
      exit 1
      ;;
  esac
  if [ "$DELVE_RESET_WHEN_EMPTY" -lt 60 ]; then
    echo "FATAL: DELVE_RESET_WHEN_EMPTY=$DELVE_RESET_WHEN_EMPTY is below the 60-second floor." >&2
    echo "A player is counted only once the server has PLACED them in the world, not when they" >&2
    echo "connect, so a shorter window can read zero straight across a login handshake and wipe" >&2
    echo "a world out from under a party that is still loading in." >&2
    exit 1
  fi
fi
# First match wins, and `sed` stops by itself rather than being cut off by a
# reader. It used to be `sed -n "s/^$1=//p" "$props" | head -1`, which is the
# SIGPIPE+pipefail shape: `head` exits at line one, `sed` dies of
# SIGPIPE, and a pipeline status of 141 becomes the function's. This script sets
# `set -e` WITHOUT `pipefail`, so that was latent rather than live — which is
# exactly why it is worth removing. Adding one `set -o pipefail` here would have
# turned every property read on the player-facing boot path into a coin flip,
# and nothing about the change would have looked dangerous.
prop() { sed -n "/^$1=/{s///;p;q;}" "$props"; }
# Difficulty. v0.6: `world.difficulty` is DECLARED by the campaign (easy/normal/
# hard) and the compiler writes it here; absent, it derives easy for a wave
# campaign and peaceful for a wave-free one (peaceful removes summoned mobs).
# Either way the file is the authority: the image's DIFFICULTY env is a fallback
# for an absent file only, and this line is what stops it from deciding how hard
# the delve is. The seed is the compiler's (ADR-0006).
d=$(prop difficulty);   if [ -n "$d" ];  then export DIFFICULTY="$d";        fi
s=$(prop level-seed);   if [ -n "$s" ];  then export SEED="$s";              fi
# World generator (spec-0013 v0.6 `horizon`): void by default, ocean superflat for
# horizon=ocean. Sourced here so every server builds the SAME world the compiler
# declared. Without this a fixed void default wins and an ocean delve boots as a
# void: content sits at y>=60 but there is no terrain, so the joining player (and
# the validate-profile bot) falls out of the world - and the PackTest runner would
# exercise a world the delve never ships.
lt=$(prop level-type);        if [ -n "$lt" ]; then export LEVEL_TYPE="$lt";        fi
gs=$(prop generator-settings); if [ -n "$gs" ]; then export GENERATOR_SETTINGS="$gs"; fi
# Chunk distances. Left underived, the two boot paths take their values from two
# different sources - the itzg base's own /image/server.properties template, and
# the vanilla jar's built-in defaults - neither of which is ours, so the delve
# renders and ticks at whatever radius the host happens to choose. Pinned in the
# compiler and read here, every server that boots this build sees the same chunks
# and ticks the same chunks (ADR-0006). itzg maps both to properties via
# /image/property-definitions.json (view-distance -> VIEW_DISTANCE,
# simulation-distance -> SIMULATION_DISTANCE).
vd=$(prop view-distance);       if [ -n "$vd" ]; then export VIEW_DISTANCE="$vd";       fi
sd=$(prop simulation-distance); if [ -n "$sd" ]; then export SIMULATION_DISTANCE="$sd"; fi
# Offline op seeding. itzg's OPS env resolves EVERY name through Mojang's
# PlayerDB - even with ONLINE_MODE=FALSE - so an offline-only name (the
# validation bot) aborts the boot: "Could not resolve user from Playerdb".
# DELVE_OPS_OFFLINE takes a name and writes /data/ops.json directly with the
# SAME deterministic UUID an offline server assigns that name on join (Java
# nameUUIDFromBytes: MD5 of "OfflinePlayer:<name>", version 3, RFC variant) -
# the name never reaches the network, and with OPS unset itzg leaves the file
# alone. Offline servers only: a real account's online UUID differs, so an
# ONLINE_MODE=TRUE server keeps using itzg's OPS env instead.
if [ -n "${DELVE_OPS_OFFLINE:-}" ]; then
  n="$DELVE_OPS_OFFLINE"
  h=$(printf 'OfflinePlayer:%s' "$n" | md5sum | cut -c1-32)
  case "${h:16:1}" in
    [048c]) v=8;; [159d]) v=9;; [26ae]) v=a;; *) v=b;;
  esac
  u="${h:0:8}-${h:8:4}-3${h:13:3}-${v}${h:17:3}-${h:20:12}"
  printf '[{"uuid":"%s","name":"%s","level":4,"bypassesPlayerLimit":false}]\n' \
    "$u" "$n" > /data/ops.json
  echo "[init] Seeded offline op $n ($u) into /data/ops.json"
fi
# OFF is the boot this image has always had: `exec`, so mc-server-runner is PID 1
# and every signal reaches it the way it does today. Everything below this line
# runs only when the operator asked for the reset.
if [ -z "${DELVE_RESET_WHEN_EMPTY:-}" ]; then
  exec /image/scripts/start "$@"
fi

# WHICH directory holds the world: `level-name`, read from the build's own file
# exactly like every world key above, never a constant typed here. The 15 pinned
# properties carry it, so the compiler is the authority; `world` is the floor for
# a file that somehow lacks it.
lvl=$(prop level-name); [ -n "$lvl" ] || lvl=world

# The EVENT, and it is not "the count reached zero". itzg's autostop daemon reads
# the online player count every AUTOSTOP_PERIOD (10 s) with a server-list ping to
# the game port, and stops the server only when EVERY reading across
# AUTOSTOP_TIMEOUT_EST seconds was zero; any non-zero reading starts the wait
# again, and a ping that fails after its retries counts as ONE player, never
# zero. That direction is the whole safety of this flag: a lagging server with a
# party inside it is never reset.
export ENABLE_AUTOSTOP=true
export AUTOSTOP_TIMEOUT_EST="$DELVE_RESET_WHEN_EMPTY"
# Upstream has no "never" for the INITIAL-idle stop, and a server nobody has
# joined is already pristine - stopping there would only cycle the boot forever.
# This is the largest value the daemon's arithmetic is known to hold, and it is a
# workaround, named here as one.
export AUTOSTOP_TIMEOUT_INIT=2147483647
# The count exists only while the server answers status pings WITH a player list.
# Both keys are among the ones the build leaves to the host, so left to chance a
# host that hid its player list would turn every reading into a failed ping,
# every failed ping into "one player", and this flag into a flag that does
# nothing - the unbound shape, with nothing anywhere saying so.
export ENABLE_STATUS=true
export HIDE_ONLINE_PLAYERS=false

# PID 1 gets no default signal handling, and the start chain is a CHILD here
# rather than an `exec`. So `docker stop` has to be forwarded by hand - and it
# must end the container rather than feed the loop, or a `docker stop` would boot
# the delve again instead of stopping it.
dw_stopping=0
dw_child=""
dw_forward() {
  dw_stopping=1
  if [ -n "$dw_child" ]; then kill -TERM "$dw_child" 2>/dev/null || true; fi
  return 0
}
trap dw_forward TERM INT

while :; do
  # A world the server is about to make under a DIFFERENT name is a world this
  # removal does not reach: the played one would survive untouched and the reset
  # would reset nothing, silently, which is the one failure this flag cannot be
  # allowed to have. The server's own file is the second reading; they must agree.
  if [ -f /data/server.properties ]; then
    running_lvl=$(sed -n '/^level-name=/{s///;p;q;}' /data/server.properties)
    if [ -n "$running_lvl" ] && [ "$running_lvl" != "$lvl" ]; then
      echo "FATAL: the build declares level-name=$lvl and the server's own /data/server.properties" >&2
      echo "says level-name=$running_lvl - so removing '$lvl' would leave the played world in place" >&2
      echo "and reset nothing at all. Refusing to boot a reset that resets nothing." >&2
      exit 1
    fi
  fi
  # The reset RESTORES; it never undoes. The world directory goes wholesale and
  # the boot below makes it again from the image - so quest scores, command
  # storage, player inventories, advancements, statistics and every block a
  # session moved are covered by one removal, and no list of carriers can go
  # stale behind it. usercache.json is the only thing outside the world folder
  # that is about players.
  for victim in "/data/$lvl" /data/usercache.json; do
    if [ -e "$victim" ]; then
      rm -rf "$victim"
      echo "[reset] removed $victim"
    else
      echo "[reset] $victim was already absent"
    fi
  done
  # Upstream's one hold, and the only hatch: while this file exists the daemon
  # logs that it is skipping and never stops. Nothing here creates it, and every
  # boot says whether it is there.
  if [ -e /data/.skip-stop ]; then
    echo "[reset] /data/.skip-stop is present - the autostop daemon will SKIP stopping this server"
  else
    echo "[reset] /data/.skip-stop is absent - this world ends ${DELVE_RESET_WHEN_EMPTY}s after the last player leaves"
  fi

  /image/scripts/start "$@" &
  dw_child=$!
  rc=0; wait "$dw_child" || rc=$?
  # A trapped signal makes `wait` return >128 while the child may still be
  # running; ask again until the child is really gone, or the exit status
  # reported here is the signal rather than the server's.
  while [ "$rc" -gt 128 ] && kill -0 "$dw_child" 2>/dev/null; do
    rc=0; wait "$dw_child" || rc=$?
  done
  dw_child=""
  if [ "$dw_stopping" = 1 ]; then
    echo "[reset] the container was signalled - this world ends here and no boot follows"
    exit "$rc"
  fi
  echo "[reset] the server stopped (exit $rc) - the last player left, so the delve is built again"
done
EOS
ENTRYPOINT ["/delve/entrypoint.sh"]

# EULA is intentionally NOT set (ADR-0010): the operator accepts it at run time.
EXPOSE 25565
