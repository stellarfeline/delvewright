# Delvewright delve image (ADR-0010): pinned vanilla server + compiled datapack +
# server config, baked into one runnable OCI image. `docker run <image>` (with the
# operator's EULA acceptance) yields a joinable dungeon.
#
# The build context is a compiler build output tree `<out>/` (produced by
# `delvec build <campaign> -o <out>`). Build with that dir as context:
#
#     delvec build crates/dsl/fixtures/valid/hello-world -o out
#     docker build -f validation/Dockerfile.delve -t delvewright/hello-world out/
#
# ADR-0010 (EULA): the server jar is NEVER baked. The base itzg entrypoint fetches
# the pinned jar (by version + checksum) at first run; only the datapack + config —
# all bytes we authored (ADR-0006) — live in image layers. The operator accepts the
# EULA at run time (EULA=TRUE); this image never sets it.
#
# ADR-0003: NO mods here. PackTest/Fabric live only in the validate-profile tooling
# services, never in the shipped delve image.

# The delve runtime base: our own GHCR mirror of itzg/minecraft-server, pinned by
# immutable digest (spec-0005, ADR-0006/0009 — MC 1.21.11, java21). Mirroring under
# our namespace shields us from Docker Hub anon-pull limits and upstream deletion.
# The digest is the single-source value in versions.toml ([images.base].digest) and
# equals the itzg source index digest (buildx imagetools create copies it verbatim);
# check-versions.sh fails CI if it drifts. Overridable via --build-arg for local
# pre-publish verification against the byte-identical itzg source (same digest).
ARG DELVE_BASE_IMAGE=ghcr.io/stellarfeline/delvewright-base@sha256:3e7db2562b492dbf442568a327d361547628c98c04a7cb68218c8dde6abdd1de
FROM ${DELVE_BASE_IMAGE}

# Bake the compiled datapack outside /data (which is a runtime volume). itzg's
# DATAPACKS env accepts a directory in the container and copies it into the world's
# datapacks folder on first boot.
COPY datapack /delve/datapack
# Provenance: the compiler's server config + manifest travel with the image, even
# though world gen below is driven by the itzg env vars mirrored from it.
COPY server /delve/server
COPY manifest.json /delve/manifest.json
COPY critical-path.json /delve/critical-path.json

ENV TYPE=VANILLA \
    VERSION=1.21.11 \
    DATAPACKS=/delve/datapack \
    # World config mirrored from the compiler's server/server.properties (spec-0002
    # void/superflat + fixed seed). The release/packaging spec will template these
    # straight from <out>/server/server.properties so they cannot drift.
    MODE=adventure \
    DIFFICULTY=peaceful \
    FORCE_GAMEMODE=true \
    LEVEL_TYPE=minecraft:flat \
    # Quotes must be backslash-escaped or Docker ENV strips them, corrupting the
    # JSON (itzg would then write invalid generator-settings and the server dies
    # with a gson syntax error).
    GENERATOR_SETTINGS="{\"biome\":\"minecraft:the_void\",\"layers\":[]}" \
    SEED=20260729 \
    GENERATE_STRUCTURES=false \
    SPAWN_MONSTERS=false \
    SPAWN_PROTECTION=0 \
    ALLOW_NETHER=false \
    PVP=false \
    # Offline by default for local play/validation; the owner sets ONLINE_MODE=TRUE
    # to join with a real account (spec-0003 auth-mode note).
    ONLINE_MODE=FALSE

# EULA is intentionally NOT set (ADR-0010): the operator accepts it at run time.
EXPOSE 25565
