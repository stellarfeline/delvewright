{
  "campaign_id": "water-deck",
  "content": {
    "quests": [
      {
        "happening": {
          "subject": "anchor/keeper-stand",
          "text": "The party comes up the stair and finds the hoist chain still moving.",
          "verb": "arrives"
        },
        "id": "quest/board",
        "objectives": [
          {
            "anchor": "spawn",
            "happening": {
              "subject": "anchor/keeper-stand",
              "text": "They reach the lower landing, where the call lever hangs.",
              "verb": "arrives"
            },
            "id": "obj/landing",
            "radius": 2,
            "type": "reach-anchor"
          }
        ],
        "on_complete": [
          {
            "text": "A lever hangs at each landing. Either one calls the cage.",
            "type": "narrate"
          }
        ],
        "trigger": {
          "type": "campaign-start"
        }
      },
      {
        "happening": {
          "subject": "anchor/exit",
          "text": "The cage takes them across and brings them back.",
          "verb": "departs"
        },
        "id": "quest/ride",
        "objectives": [
          {
            "anchor": "spawn",
            "happening": {
              "subject": "anchor/exit",
              "text": "They step off at the landing they started from, having ridden.",
              "verb": "arrives"
            },
            "id": "obj/return",
            "radius": 2,
            "requires_flags": [
              "flag/rode"
            ],
            "type": "reach-anchor"
          }
        ],
        "on_complete": [
          {
            "happening": {
              "subject": "anchor/exit",
              "text": "The chain goes still.",
              "verb": "departs"
            },
            "type": "campaign-complete"
          }
        ],
        "trigger": {
          "quest": "quest/board",
          "type": "quest-complete"
        }
      }
    ],
    "state": [
      {
        "id": "state/car-at-floor",
        "initial": 1,
        "note": "Which landing the ONE car occupies. There is exactly one car and it exists at exactly one floor at a time (design of record), so this datum is the whole of the lift's position.",
        "scope": "party"
      },
      {
        "id": "state/ride-in-progress",
        "initial": 0,
        "note": "1 from the first tick of a ride to its last. Every control is gated on it being 0, which is how `a pull during a ride is ignored, not queued` (planner ruling) is expressed: the tick line's guard is false, and the interaction record is discarded unconditionally on the same tick, so nothing survives to be replayed.",
        "scope": "party"
      }
    ],
