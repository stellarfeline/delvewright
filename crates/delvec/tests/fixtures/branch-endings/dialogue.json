          {
            "id": "dlg/greeting",
            "options": [
              {
                "label": "Who are you?",
                "next": "dlg/lore"
              },
              {
                "effects": [
                  {
                    "flag": "flag/wait",
                    "type": "set-flag"
                  },
                  {
