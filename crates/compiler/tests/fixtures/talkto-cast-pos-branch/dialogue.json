{
  "dsl_version": "0.8.0",
  "campaign_id": "talkto-cast-branch",
  "stage": "dialogue",
  "content": {
    "dialogues": [
      {
        "npc": "npc/keeper",
        "root": "dlg/greeting",
        "nodes": [
          {
            "id": "dlg/greeting",
            "text": "Halt, traveler. The moor road is drowned and the gate stays shut. Well? Do we hold, or do you run?",
            "options": [
              {
                "label": "Who are you?",
                "next": "dlg/lore"
              },
              {
                "label": "We hold.",
                "effects": [
                  {
                    "type": "set-flag",
                    "flag": "flag/wait"
                  },
                  {
                    "type": "complete-objective",
                    "objective": "obj/decide"
                  }
                ],
                "happening": {
                  "verb": "believes",
                  "text": "The party promises the Keeper they will stand the watch — the hold branch opens.",
                  "subject": "npc/keeper"
                }
              },
              {
                "label": "I run.",
                "effects": [
                  {
                    "type": "set-flag",
                    "flag": "flag/flee"
                  },
                  {
                    "type": "complete-objective",
                    "objective": "obj/decide"
                  }
                ],
                "happening": {
                  "verb": "believes",
                  "text": "The party refuses the watch — the bolt branch opens.",
                  "subject": "npc/keeper"
                }
              },
              {
                "label": "The watch is stood.",
                "requires_flags": [
                  "flag/wait"
                ],
                "next": "dlg/hold"
              },
              {
                "label": "One last word.",
                "requires_flags": [
                  "flag/flee"
                ],
                "next": "dlg/bolt"
              }
            ]
          },
          {
            "id": "dlg/lore",
            "text": "I am the Keeper. I have watched this gate since the moor swallowed the old road.",
            "options": [
              {
                "label": "Back.",
                "next": "dlg/greeting"
              }
            ]
          },
          {
            "id": "dlg/hold",
            "text": "So it is. Dawn, and the moor kept its distance. The gate is yours, and so is the road.",
            "options": [
              {
                "label": "Then we go.",
                "effects": [
                  {
                    "type": "complete-objective",
                    "objective": "obj/parley"
                  }
                ],
                "happening": {
                  "verb": "gains",
                  "text": "The watch is relieved and the party leaves by the front door, earned."
                }
              }
            ]
          },
          {
            "id": "dlg/bolt",
            "text": "You ran, and I opened the way anyway. Take it. Do not look back.",
            "options": [
              {
                "label": "Goodbye, Keeper.",
                "effects": [
                  {
                    "type": "complete-objective",
                    "objective": "obj/parley"
                  }
                ],
                "happening": {
                  "verb": "loses",
                  "text": "The party takes the road with the watch unstood behind them."
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
