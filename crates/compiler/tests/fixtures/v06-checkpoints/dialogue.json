              { "label": "Who are you?", "next": "dlg/lore" },
              { "label": "I'll clear the keep.", "effects": [ { "type": "complete-objective", "objective": "obj/talk" } ] },
              { "label": "What lies past the door?", "requires_flags": ["flag/summoned"], "next": "dlg/secret", "effects": [ { "type": "set-flag", "flag": "flag/curious" } ] }
            ]
          },
          {
            "id": "dlg/lore",
            "text": "The captain who lost this place. I hold the gate still, because I cannot leave it.",
            "options": [
              { "label": "Back.", "next": "dlg/greet" }
            ]
          },
          {
            "id": "dlg/secret",
            "text": "A shrine older than the keep. Reach it, and the moor's hold breaks.",
            "options": [
              { "label": "Back.", "next": "dlg/greet" }
            ]
          }
        ]
      }
    ]
