# Binary prefab assets are tracked via git-lfs (ADR-0004, ADR-0007).
prefabs/**/*.nbt filter=lfs diff=lfs merge=lfs -text

# For Windows compatibility.
# Shell and Dockerfiles are executed inside Linux containers, but a Windows checkout would turn them into CRLF.
# Force LF in the working tree on every platform.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
**/Dockerfile.* text eol=lf
