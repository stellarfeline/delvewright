.DS_Store
references/
target/
node_modules/
*.log
.claude/worktrees/

# Compiler build output consumed by the validation compose profiles / CI
# (regenerated by `delvec build ... -o validation/delve-output`). The glob also
# covers the extra trees a second `DELVE_OUTPUT` pass builds, e.g.
# `validation/delve-output-cast` (spec-0020's cast-ledger PackTest run).
validation/delve-output*/

# spec-0023 bot-ladder run artifact (`validation/run-out/run-report.json`): the
# stage results, assist-window ledger, die-retry trials and floor findings the
# `validate` profile's bot writes. A per-run artifact, never committed.
validation/run-out/

# spec-0005 server-jar cache (actions/cache in CI; primed locally). Never committed —
# the Mojang jar is fetched by checksum, never redistributed (ADR-0010).
validation/.jar-cache/

# task #41 server-bootstrap overlay (validation/server-bootstrap-cache.sh): the
# pinned Mojang jar plus the Fabric launch jar and its Class-Path, fetched ONCE per
# job and copied into each ladder's world volume. Never committed and never baked
# into a layer — the jar is fetched by checksum, never redistributed (ADR-0010).
validation/server-cache/

# spec-0006 playtest note-flow artifacts (regenerated by playtest-note-flow.sh:
# captured server log + harvested report). `*.log` already covers playtest.log.
validation/playtest-report.json
# spec-0019 rehearsal-flow artifacts (regenerated by rehearsal-flow.sh).
validation/rehearsal-report.json
validation/shot-patch.json
validation/rehearsal-bot.out
campaigns
# Read-only content-repo clone used by the skin toolchain workflow (spec-0009);
# never part of the GPL code repo.
content-repo/

# Python
__pycache__/
*.pyc

# Machine-local override of delvewright.toml (endpoints, model choices). Never
# committed; it must never hold an API key either — configs name the env var that
# does (docs/reference/i18n.md).
# The local override file and ANY suffixed variant of it. The bare name alone
# was not enough: `delvewright.local.toml_test` reached a PUBLIC repo in #334,
# because a scratch copy made while testing the refimg provider fell outside a
# pattern that matched only the exact name. No key leaked — the file names an
# ENV VAR (`api_key_env`), never a value, which is the property that made a
# mistake here survivable — but the pattern is what should have caught it.
delvewright.local.toml*

# Owner-private working notes — never committed (stays local even when the
# repo goes public).
docs/notes/private/

# Release-shelf build output (tools/build-release-binaries.sh).
dist/

# Reference images are generation-time working material: never shipped,
# never in the content repo (see [refimg] in delvewright.toml).
.refimg/

# Contact sheets + their score files, same rule: candidate renders laid out for
# the owner to curate massing from (`delve-render contact-sheet`,
# `tools/refscore.py`), and the palette swatch sheets under `.sheets/palette/`
# (`tools/block-appearance.py --sheet`), which are tiled Mojang texture pixels.
# Generation-time working material — never shipped, never in the content repo, so
# nothing on a sheet can carry licensing into a delve (ADR-0013) or move its
# bytes (ADR-0006). The tool refuses to write a sheet anywhere else in the repo.
.sheets/

# The opt-in local virtualenv holding the similarity-metric backends
# (open_clip_torch, t2v-metrics). Multi-GB with their PyTorch dependency and
# deliberately absent from CI — see [refscore] in delvewright.toml.
.refscore-venv/
