{
  "documents": {
    "clean.yml": {
      "jobs": {
        "plan": {
          "name": "work out whether there is anything to do",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "./.github/actions/fixture-checkout"
            },
            {
              "name": "decide",
              "run": "echo \"publish=true\" >> \"$GITHUB_OUTPUT\"\n"
            }
          ]
        },
        "publish": {
          "environment": "crates-io",
          "name": "publish (owner approval)",
          "needs": "plan",
          "permissions": {
            "actions": "read",
            "contents": "read"
          },
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "./.github/actions/fixture-checkout"
            },
            {
              "env": {
                "GH_TOKEN": "${{ github.token }}"
              },
              "name": "the gate actually bound",
              "run": "bash tools/assert-run-approved.sh crates-io"
            },
            {
              "uses": "./.github/actions/fixture-cache",
              "with": {
                "key": "fixture"
              }
            },
            {
              "name": "the irreversible act",
              "run": "bash tools/does-the-thing.sh"
            }
          ]
        }
      },
      "name": "fixture — a guarded environment job",
      "permissions": {
        "contents": "read"
      },
      "true": {
        "push": {
          "branches": [
            "main"
          ]
        }
      }
    },
    "environment-mapping.yml": {
      "jobs": {
        "publish": {
          "environment": {
            "name": "crates-io",
            "url": "https://crates.io/crates/delvec"
          },
          "name": "publish (owner approval)",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "./.github/actions/fixture-checkout"
            },
            {
              "name": "the gate actually bound",
              "run": "set -euo pipefail\n# Shell options and comments may lead; nothing else may.\nbash tools/assert-run-approved.sh crates-io\n"
            },
            {
              "name": "the irreversible act",
              "run": "bash tools/does-the-thing.sh"
            }
          ]
        }
      },
      "name": "fixture — the environment is a mapping, and the run has a prelude",
      "true": {
        "push": {
          "branches": [
            "main"
          ]
        }
      }
    },
